{
  "name": "mbc-impact-platform",
  "version": "0.1.0",
  "private": true,
  "description": "M.Bryan Conference Impact Measurement Platform monorepo",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "postinstall": "pnpm --filter @mbc/shared build",
    "prepare": "husky",
    "screenshots": "node scripts/screenshots.mjs",
    "mail:test": "pnpm --filter @mbc/api mail:test",
    "email:screenshots": "node scripts/email-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}

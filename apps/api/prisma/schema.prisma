// Prisma schema for the API and worker (Increment 1: foundation tables only).
// The connection URL (DATABASE_URL) is supplied by prisma.config.ts, as Prisma 7 requires.
// Forms, questions and responses arrive in Increment 2.
//
// Conventions
// - UUID primary keys generated by PostgreSQL (gen_random_uuid()).
// - snake_case table and column names; camelCase in TypeScript via @map / @@map.
// - Timestamps are timestamptz in UTC. Dates without a time (event days) use `date`.
// - Every record that belongs to an event carries event_id (user_account is the exception: staff
//   accounts span events; delegates link to an event through the delegate table).
//
// SQL that PSL cannot express lives in the migration files (see prisma/migrations):
// - unique index on lower(email) for user_account
// - partial unique index on (event_id, lower(email)) for delegates that are not duplicates
// - the trigger that makes audit_log append-only

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------ enums

enum EventStatus {
  draft
  active
  archived

  @@map("event_status")
}

enum EventFormat {
  physical
  virtual
  hybrid

  @@map("event_format")
}

enum ParticipationCode {
  physical
  virtual

  @@map("participation_code")
}

enum UserRole {
  delegate
  admin
  analyst
  support
  speaker

  @@map("user_role")
}

enum UserStatus {
  active
  inactive

  @@map("user_status")
}

enum DelegateCapacity {
  individual
  nominee
  other

  @@map("delegate_capacity")
}

enum RegistrationStatus {
  valid
  cancelled
  duplicate
  test

  @@map("registration_status")
}

enum InvitationStatus {
  pending
  sent
  bounced
  accepted
  expired
  revoked

  @@map("invitation_status")
}

enum ConsentDocument {
  privacy

  @@map("consent_document")
}

enum SignInPurpose {
  signin
  invite_accept

  @@map("sign_in_purpose")
}

enum AuthAttemptKind {
  request_link
  verify

  @@map("auth_attempt_kind")
}

/// Role of an address within an identity (backlog D5.1): exactly one current address per identity,
/// previous addresses kept as historical, and provisional reservations from the migration gate
/// (Case A) that no other identity may claim until an audited decision resolves them.
enum IdentityEmailKind {
  current
  historical
  provisional

  @@map("identity_email_kind")
}

/// How an address row was established (backlog D5.1 invariant 3 and H3).
enum IdentityEmailEvidence {
  /// Current address taken from the account or registration record by the backfill.
  backfill
  /// Historical address backed by an audit entry that recorded the exact old-to-new change.
  verified
  /// Historical or provisional address settled by an audited admin decision.
  admin_decision
  /// Provisional reservation: evidence incomplete (Case A); not usable for matching.
  unverified
  /// Current address of an identity created by a committed import run (D3 step 6).
  import

  @@map("identity_email_evidence")
}

/// Lifecycle of an upload (D3): rows parsed and stored, previewed, then committed or discarded.
enum ImportRunStatus {
  uploaded
  previewed
  committed
  discarded

  @@map("import_run_status")
}

/// Outcome of one file row (D6 import_row). "unchanged" is "updated (no change)" in the preview.
enum ImportRowOutcome {
  accepted
  updated
  unchanged
  linked
  duplicate_in_file
  rejected
  conflict

  @@map("import_row_outcome")
}

/// The four admin decisions on a quarantined row (D5): the valid ones depend on the conflict.
enum ImportResolution {
  link_existing
  create_identity
  reject
  correct_source

  @@map("import_resolution")
}

// ------------------------------------------------------------------ event setup (E1)

model Event {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String      @unique
  name      String
  theme     String?
  startsOn  DateTime    @map("starts_on") @db.Date
  endsOn    DateTime    @map("ends_on") @db.Date
  timezone  String      @default("Africa/Lagos")
  location  String?
  format    EventFormat @default(hybrid)
  status    EventStatus @default(draft)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  participationCategories ParticipationCategory[]
  delegates               Delegate[]
  importRuns              ImportRun[]

  @@map("event")
}

model ParticipationCategory {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String            @map("event_id") @db.Uuid
  code      ParticipationCode
  name      String
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@index([eventId])
  @@map("participation_category")
}

// ------------------------------------------------------------------ accounts and delegates (E2, E3)

model UserAccount {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored lower-cased and trimmed; a unique index on lower(email) in the migration enforces it.
  email        String     @unique
  role         UserRole
  status       UserStatus @default(active)
  lastSignInAt DateTime?  @map("last_sign_in_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  delegates    Delegate[]
  authSessions AuthSession[]
  signInTokens SignInToken[]
  identity     DelegateIdentity?

  @@map("user_account")
}

// ------------------------------------------------------------------ platform identity (backlog D6, D5.1)

/// One row per person across events (E2-2). The current, historical and provisional addresses
/// live in identity_email, where one unique index enforces global ownership (H1, H4).
model DelegateIdentity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Established name, preserved across imports (D5: never overwritten by a file).
  displayName   String   @map("display_name")
  /// The authentication account linked at first sign-in or by the backfill; at most one per identity.
  userAccountId String?  @unique @map("user_account_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userAccount UserAccount?    @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  emails      IdentityEmail[]
  delegates   Delegate[]

  @@map("delegate_identity")
}

/// Address ownership store. `emailNormalised` is unique across every kind, so an address can be
/// the current, historical or provisional address of at most one identity (D5.1 invariants 1, 3).
/// A partial unique index in the migration also guarantees one current address per identity.
model IdentityEmail {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId      String                @map("identity_id") @db.Uuid
  /// normaliseEmail(): NFC, trimmed, lower-cased.
  emailNormalised String                @unique @map("email_normalised")
  kind            IdentityEmailKind
  evidence        IdentityEmailEvidence
  /// The audit_log row that established this address, when one exists (no FK: audit rows outlive records).
  auditLogId      String?               @map("audit_log_id") @db.Uuid
  actorUserId     String?               @map("actor_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  identity DelegateIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@index([identityId])
  @@map("identity_email")
}

model Delegate {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                String             @map("event_id") @db.Uuid
  userAccountId          String?            @map("user_account_id") @db.Uuid
  /// Platform identity (D6); nullable during the expand phase, filled by the backfill (D6.1).
  identityId             String?            @map("identity_id") @db.Uuid
  name                   String
  email                  String
  organisation           String?
  jobTitle               String?            @map("job_title")
  country                String?
  attendanceFormat       ParticipationCode  @map("attendance_format")
  capacity               DelegateCapacity   @default(individual)
  nominatingOrganisation String?            @map("nominating_organisation")
  registrationStatus     RegistrationStatus @default(valid) @map("registration_status")
  duplicateOfId          String?            @map("duplicate_of_id") @db.Uuid
  /// Registration source the record was imported from (D4); scopes the external id.
  registrationSource     String?            @map("registration_source")
  /// The registration platform's own id for the row, unique per event and source (D4, D5).
  externalRegistrationId String?            @map("external_registration_id")
  importedAt             DateTime?          @map("imported_at") @db.Timestamptz(3)
  /// Set when the delegate first signs in and the account is linked (E3-2).
  signedUpAt             DateTime?          @map("signed_up_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userAccount UserAccount?      @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  identity    DelegateIdentity? @relation(fields: [identityId], references: [id], onDelete: Restrict)
  duplicateOf Delegate?         @relation("DelegateDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Delegate[]        @relation("DelegateDuplicates")
  invitations Invitation[]
  consents    ConsentRecord[]
  importRows  ImportRow[]

  @@index([eventId])
  @@index([email])
  @@index([userAccountId])
  @@index([identityId])
  @@index([eventId, registrationStatus])
  @@map("delegate")
}

// ------------------------------------------------------------------ registration imports (E2-1, E2-8..11; D3, D6, D9)

/// One per upload. Row contents live in import_row; the run holds who, when, file name and hash,
/// mapping, counts and outcome (D3 step 7). The original file is not retained (OQ-22 open).
model ImportRun {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                 String             @map("event_id") @db.Uuid
  actorUserId             String             @map("actor_user_id") @db.Uuid
  /// Registration source chosen explicitly by the admin (D3 step 1, D4).
  source                  String
  fileName                String             @map("file_name")
  /// SHA-256 of the uploaded bytes; part of the preview fingerprint.
  fileHash                String             @map("file_hash")
  fileSizeBytes           Int                @map("file_size_bytes")
  rowCount                Int                @map("row_count")
  /// Header names as read from the file, in column order.
  headers                 Json
  mapping                 Json?
  attendanceFormatDefault ParticipationCode? @map("attendance_format_default")
  status                  ImportRunStatus    @default(uploaded)
  /// Hash of file, mapping and the snapshot of matched records (D3 step 5); null until previewed.
  fingerprint             String?
  previewExpiresAt        DateTime?          @map("preview_expires_at") @db.Timestamptz(3)
  counts                  Json?
  committedAt             DateTime?          @map("committed_at") @db.Timestamptz(3)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rows  ImportRow[]

  @@index([eventId, createdAt])
  @@map("import_run")
}

/// One per file row: the raw cells, the normalised values once mapped, the outcome and reason,
/// both sides of a conflict, and the delegate or identity it produced or touched (D6).
model ImportRow {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId             String            @map("run_id") @db.Uuid
  /// 1-based data row number as the admin sees it in the file (the header is row 1).
  rowNumber         Int               @map("row_number")
  raw               Json
  values            Json?
  outcome           ImportRowOutcome?
  reasonCode        String?           @map("reason_code")
  reasonDetail      String?           @map("reason_detail")
  possibleDuplicate Boolean           @default(false) @map("possible_duplicate")
  conflict          Json?
  delegateId        String?           @map("delegate_id") @db.Uuid
  identityId        String?           @map("identity_id") @db.Uuid
  /// Admin decision on a conflict row (D5); null while the row waits in the queue.
  resolution        ImportResolution? @map("resolution")
  resolvedAt        DateTime?         @map("resolved_at") @db.Timestamptz(3)
  resolvedByUserId  String?           @map("resolved_by_user_id") @db.Uuid
  resolutionNote    String?           @map("resolution_note")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  run      ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  delegate Delegate? @relation(fields: [delegateId], references: [id], onDelete: SetNull)

  @@unique([runId, rowNumber])
  @@index([runId, outcome])
  @@map("import_row")
}

/// Column mapping saved per registration source (E2-8, D4); reused only when the header
/// signature matches exactly, otherwise the admin confirms a mapping again.
model ImportSourceMapping {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source          String   @unique
  headerSignature String   @map("header_signature")
  mapping         Json
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("import_source_mapping")
}

model Invitation {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delegateId String           @map("delegate_id") @db.Uuid
  /// SHA-256 of the single-use token; the token itself is never stored.
  tokenHash  String           @unique @map("token_hash")
  status     InvitationStatus @default(pending)
  sentAt     DateTime?        @map("sent_at") @db.Timestamptz(3)
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(3)
  bouncedAt  DateTime?        @map("bounced_at") @db.Timestamptz(3)
  expiresAt  DateTime?        @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  delegate Delegate @relation(fields: [delegateId], references: [id], onDelete: Cascade)

  @@index([delegateId])
  @@map("invitation")
}

model ConsentRecord {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delegateId String          @map("delegate_id") @db.Uuid
  document   ConsentDocument @default(privacy)
  version    String
  acceptedAt DateTime        @default(now()) @map("accepted_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  delegate Delegate @relation(fields: [delegateId], references: [id], onDelete: Cascade)

  @@unique([delegateId, document, version])
  @@index([delegateId])
  @@map("consent_record")
}

// ------------------------------------------------------------------ audit log (E17-4), append-only
// No foreign keys on purpose: audit rows must outlive the records and users they describe, and an
// ON DELETE SET NULL would be an UPDATE, which the append-only trigger rejects. event_id and
// actor_user_id are historical references.

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  eventId     String?   @map("event_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  /// Verb in dotted form, e.g. "delegate.status_changed", "export.created".
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  oldValue    Json?     @map("old_value")
  newValue    Json?     @map("new_value")
  ip          String?
  userAgent   String?   @map("user_agent")

  @@index([eventId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("audit_log")
}

// ------------------------------------------------------------------ authentication (E3-3..6)

/// Server-side session. The cookie carries a random token; only its SHA-256 is stored here.
model AuthSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccountId String    @map("user_account_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Absolute expiry (SESSION_TTL_DAYS); idle expiry is derived from lastSeenAt.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// SHA-256 of the client IP; never the IP itself.
  ipHash        String?   @map("ip_hash")
  userAgent     String?   @map("user_agent")

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@index([userAccountId])
  @@index([expiresAt])
  @@map("auth_session")
}

/// Magic link / one-time code. Raw token and code are emailed once; only hashes are stored.
model SignInToken {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lower-cased address the link was sent to.
  email         String
  userAccountId String?       @map("user_account_id") @db.Uuid
  purpose       SignInPurpose @default(signin)
  tokenHash     String        @unique @map("token_hash")
  codeHash      String?       @map("code_hash")
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime?     @map("used_at") @db.Timestamptz(3)
  /// Failed verification attempts against this token (code guessing).
  attempts      Int           @default(0)
  /// Relative path to return to after sign-in (deep links, E3-5).
  targetPath    String?       @map("target_path")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  userAccount UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("sign_in_token")
}

/// Rate-limiting ledger for authentication requests; survives restarts and multiple api replicas.
model AuthAttempt {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        AuthAttemptKind
  /// Keyed hash of the normalised email (no plaintext addresses in the ledger).
  emailHash   String?         @map("email_hash")
  ipHash      String?         @map("ip_hash")
  attemptedAt DateTime        @default(now()) @map("attempted_at") @db.Timestamptz(3)

  @@index([emailHash, attemptedAt])
  @@index([ipHash, attemptedAt])
  @@map("auth_attempt")
}

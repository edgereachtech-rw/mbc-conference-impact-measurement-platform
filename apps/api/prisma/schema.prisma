// Prisma schema for the API and worker (Increment 1: foundation tables only).
// The connection URL (DATABASE_URL) is supplied by prisma.config.ts, as Prisma 7 requires.
// Forms, questions and responses arrive in Increment 2.
//
// Conventions
// - UUID primary keys generated by PostgreSQL (gen_random_uuid()).
// - snake_case table and column names; camelCase in TypeScript via @map / @@map.
// - Timestamps are timestamptz in UTC. Dates without a time (event days) use `date`.
// - Every record that belongs to an event carries event_id (user_account is the exception: staff
//   accounts span events; delegates link to an event through the delegate table).
//
// SQL that PSL cannot express lives in the migration files (see prisma/migrations):
// - unique index on lower(email) for user_account
// - partial unique index on (event_id, lower(email)) for delegates that are not duplicates
// - the trigger that makes audit_log append-only

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------ enums

enum EventStatus {
  draft
  active
  archived

  @@map("event_status")
}

enum EventFormat {
  physical
  virtual
  hybrid

  @@map("event_format")
}

enum EventType {
  conference
  workshop
  seminar
  summit
  training
  other

  @@map("event_type")
}

/// Attendance (attendance requirements, 2026-10-30): recorded per delegate per event date,
/// never inferred from registration or an assessment submission.
enum AttendanceStatus {
  attended
  partial
  absent

  @@map("attendance_status")
}

enum AttendanceMode {
  physical
  virtual

  @@map("attendance_mode")
}

enum AttendanceMethod {
  qr
  manual
  bulk
  closure
  correction

  @@map("attendance_method")
}

/// Daily Learning Reflections (task of 2026-10-31): one optional questionnaire per event date,
/// configured and published by admins, answered once by each delegate. Separate from attendance,
/// session feedback, the Transfer Plan and the assessment stages.
enum ReflectionStatus {
  draft
  published
  closed

  @@map("reflection_status")
}

enum ReflectionQuestionType {
  short_text
  long_text

  @@map("reflection_question_type")
}

/// Session feedback (task of 2026-10-31): a questionnaire per session, answered after the
/// session by delegates recorded as attending it; one response per delegate, updatable, with
/// earlier revisions kept. Separate from reflections, attendance and the assessments.
enum FeedbackQuestionType {
  rating
  long_text

  @@map("feedback_question_type")
}

/// Individual Transfer Plan (task of 2026-10-31): one continuous plan per delegate per event,
/// several planned actions, progress per action, reminder preferences, and the original
/// submission kept as a snapshot. Separate from attendance, feedback and the assessments.
enum TransferPlanStatus {
  draft
  submitted

  @@map("transfer_plan_status")
}

/// Progress of one planned action (backlog E12-8, Appendix B). "Started", "in progress" and
/// "completed" are not application; application is "applied" or "applied consistently".
enum ActionProgressStatus {
  not_started
  started
  in_progress
  applied
  applied_consistently
  completed
  changed
  no_longer_applicable

  @@map("action_progress_status")
}

enum ReminderFrequency {
  none
  weekly
  fortnightly
  monthly

  @@map("reminder_frequency")
}

enum SessionType {
  keynote
  plenary
  panel
  workshop
  breakout
  transfer_planning
  networking
  other

  @@map("session_type")
}

enum AssessmentStage {
  pre_conference
  during_conference
  end_of_conference
  follow_up

  @@map("assessment_stage")
}

enum AssessmentStageStatus {
  draft
  scheduled
  open
  closed

  @@map("assessment_stage_status")
}

enum AssessmentTarget {
  all_delegates
  group

  @@map("assessment_target")
}

/// Who a section is shown to: everyone, or only delegates registered as physical or virtual.
enum SectionAudience {
  all
  physical
  virtual

  @@map("section_audience")
}

/// How a section's single-choice questions are marked; see sectionMarkings in @mbc/shared.
enum SectionMarking {
  none
  scored
  knowledge

  @@map("section_marking")
}

enum QuestionType {
  short_text
  long_text
  single_choice
  multiple_choice
  rating
  yes_no
  number
  date

  @@map("question_type")
}

enum ParticipationCode {
  physical
  virtual

  @@map("participation_code")
}

enum UserRole {
  delegate
  admin
  analyst
  support
  speaker

  @@map("user_role")
}

enum UserStatus {
  active
  inactive

  @@map("user_status")
}

enum DelegateCapacity {
  individual
  nominee
  other

  @@map("delegate_capacity")
}

/// Decided 2026-10-30: `active` replaces `valid`; `pending` is imported or set by an admin, cannot
/// sign in, is hidden from My Events and excluded from active-registration counts until an admin
/// sets it to active. `duplicate` and `test` are never set by an import.
enum RegistrationStatus {
  active
  pending
  cancelled
  duplicate
  test

  @@map("registration_status")
}

enum DelegateMessageStatus {
  sending
  sent
  partially_failed
  failed

  @@map("delegate_message_status")
}

enum DelegateMessageRecipientStatus {
  queued
  sent
  failed

  @@map("delegate_message_recipient_status")
}

enum InvitationStatus {
  pending
  sent
  bounced
  accepted
  expired
  revoked

  @@map("invitation_status")
}

enum ConsentDocument {
  privacy

  @@map("consent_document")
}

enum SignInPurpose {
  signin
  invite_accept

  @@map("sign_in_purpose")
}

enum AuthAttemptKind {
  request_link
  verify

  @@map("auth_attempt_kind")
}

/// Role of an address within an identity (backlog D5.1): exactly one current address per identity,
/// previous addresses kept as historical, and provisional reservations from the migration gate
/// (Case A) that no other identity may claim until an audited decision resolves them.
enum IdentityEmailKind {
  current
  historical
  provisional

  @@map("identity_email_kind")
}

/// How an address row was established (backlog D5.1 invariant 3 and H3).
enum IdentityEmailEvidence {
  /// Current address taken from the account or registration record by the backfill.
  backfill
  /// Historical address backed by an audit entry that recorded the exact old-to-new change.
  verified
  /// Historical or provisional address settled by an audited admin decision.
  admin_decision
  /// Provisional reservation: evidence incomplete (Case A); not usable for matching.
  unverified
  /// Current address of an identity created by a committed import run (D3 step 6).
  import

  @@map("identity_email_evidence")
}

/// Lifecycle of an upload (D3): rows parsed and stored, previewed, then committed or discarded.
enum ImportRunStatus {
  uploaded
  previewed
  committed
  discarded

  @@map("import_run_status")
}

/// Outcome of one file row (D6 import_row). "unchanged" is "updated (no change)" in the preview.
enum ImportRowOutcome {
  accepted
  updated
  unchanged
  linked
  duplicate_in_file
  rejected
  conflict

  @@map("import_row_outcome")
}

/// The four admin decisions on a quarantined row (D5): the valid ones depend on the conflict.
enum ImportResolution {
  link_existing
  create_identity
  reject
  correct_source

  @@map("import_resolution")
}

// ------------------------------------------------------------------ event setup (E1)

model Event {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug           String      @unique
  name           String
  theme          String?
  startsOn       DateTime    @map("starts_on") @db.Date
  endsOn         DateTime    @map("ends_on") @db.Date
  timezone       String      @default("Africa/Lagos")
  location       String?
  format         EventFormat @default(hybrid)
  status         EventStatus @default(draft)
  /// Structured profile (E1 brief, section 3). The slug is the unique event code.
  description    String      @default("")
  eventType      EventType   @default(conference) @map("event_type")
  organiser      String      @default("")
  website        String?
  imageUrl       String?     @map("image_url")
  additionalInfo String?     @map("additional_info")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  participationCategories ParticipationCategory[]
  delegates               Delegate[]
  importRuns              ImportRun[]
  messages                DelegateMessage[]
  dates                   EventDate[]
  sessions                EventSession[]
  assessmentStages        AssessmentStageConfig[]
  assessmentQuestions     AssessmentQuestion[]
  assessmentSections      AssessmentSection[]
  attendanceTokens        AttendanceToken[]
  attendanceRecords       AttendanceRecord[]
  sessionAttendance       SessionAttendance[]
  reflectionActivities    ReflectionActivity[]
  reflectionQuestions     ReflectionQuestion[]
  reflectionResponses     ReflectionResponse[]
  feedbackQuestions       SessionFeedbackQuestion[]
  feedbackResponses       SessionFeedbackResponse[]
  transferPlans           TransferPlan[]
  referenceQuestions      EventReferenceQuestion[]

  @@map("event")
}

/// One selected event date (E1 brief, section 4). Dates are picked individually and need not be
/// consecutive; the event's starts_on/ends_on are derived from the earliest and latest row.
model EventDate {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                  String    @map("event_id") @db.Uuid
  date                     DateTime  @db.Date
  /// Set when an admin closes attendance for the date; absences are only recorded after that.
  attendanceClosedAt       DateTime? @map("attendance_closed_at") @db.Timestamptz(3)
  attendanceClosedByUserId String?   @map("attendance_closed_by_user_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions   EventSession[]
  tokens     AttendanceToken[]
  attendance AttendanceRecord[]
  reflection ReflectionActivity?

  @@unique([eventId, date])
  @@map("event_date")
}

model ReflectionActivity {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String           @map("event_id") @db.Uuid
  eventDateId String           @unique @map("event_date_id") @db.Uuid
  title       String
  status      ReflectionStatus @default(draft)
  opensAt     DateTime?        @map("opens_at") @db.Timestamptz(3)
  closesAt    DateTime?        @map("closes_at") @db.Timestamptz(3)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(3)
  closedAt    DateTime?        @map("closed_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventDate EventDate            @relation(fields: [eventDateId], references: [id], onDelete: Cascade)
  questions ReflectionQuestion[]
  responses ReflectionResponse[]

  @@index([eventId])
  @@map("reflection_activity")
}

/// Versioned like assessment questions: an edit after answers retires the row and creates
/// version + 1 under the same key, so every answer keeps the wording it answered.
model ReflectionQuestion {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId  String                 @map("activity_id") @db.Uuid
  eventId     String                 @map("event_id") @db.Uuid
  questionKey String                 @default(dbgenerated("gen_random_uuid()")) @map("question_key") @db.Uuid
  version     Int                    @default(1)
  order       Int
  prompt      String
  type        ReflectionQuestionType @default(long_text)
  required    Boolean                @default(true)
  /// Answers are participant concerns the organisers must see promptly.
  concern     Boolean                @default(false)
  retiredAt   DateTime?              @map("retired_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  activity ReflectionActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers  ReflectionAnswer[]

  @@unique([questionKey, version])
  @@index([activityId])
  @@map("reflection_question")
}

model ReflectionResponse {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  delegateId  String   @map("delegate_id") @db.Uuid
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  activity ReflectionActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  delegate Delegate           @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  answers  ReflectionAnswer[]

  @@unique([activityId, delegateId])
  @@index([delegateId])
  @@map("reflection_response")
}

model ReflectionAnswer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId String   @map("response_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  value      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  response ReflectionResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question ReflectionQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("reflection_answer")
}

/// One QR code per registered delegate per event date. The code carries a random token; only
/// its hash is stored, and holding the code never counts as attendance by itself.
model AttendanceToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  delegateId  String    @map("delegate_id") @db.Uuid
  eventDateId String    @map("event_date_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  delegate  Delegate  @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  eventDate EventDate @relation(fields: [eventDateId], references: [id], onDelete: Cascade)

  @@unique([delegateId, eventDateId])
  @@map("attendance_token")
}

/// Attendance of one delegate on one event date, with who recorded it and how. Corrections keep
/// the row and write old and new values to the audit log.
model AttendanceRecord {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String           @map("event_id") @db.Uuid
  delegateId       String           @map("delegate_id") @db.Uuid
  eventDateId      String           @map("event_date_id") @db.Uuid
  status           AttendanceStatus
  mode             AttendanceMode
  method           AttendanceMethod
  recordedByUserId String           @map("recorded_by_user_id") @db.Uuid
  note             String?
  recordedAt       DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  delegate  Delegate  @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  eventDate EventDate @relation(fields: [eventDateId], references: [id], onDelete: Cascade)

  @@unique([delegateId, eventDateId])
  @@index([eventId, eventDateId])
  @@map("attendance_record")
}

/// Presence at one session, recorded by an admin; separate from the event-date record.
model SessionAttendance {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String           @map("event_id") @db.Uuid
  delegateId       String           @map("delegate_id") @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  method           AttendanceMethod @default(manual)
  recordedByUserId String           @map("recorded_by_user_id") @db.Uuid
  recordedAt       DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(3)

  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  delegate Delegate     @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  session  EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([delegateId, sessionId])
  @@index([sessionId])
  @@map("session_attendance")
}

/// A programme session (E1 brief, section 5): optional, always on one of the event's selected dates.
/// Times are wall-clock in the event's time zone (HH:MM); the date row fixes the day.
model EventSession {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId               String      @map("event_id") @db.Uuid
  eventDateId           String      @map("event_date_id") @db.Uuid
  title                 String
  sessionType           SessionType @map("session_type")
  startTime             String      @map("start_time")
  endTime               String      @map("end_time")
  description           String?
  venue                 String?
  speaker               String?
  capacity              Int?
  /// The designated completion session for Transfer Planning (else the last such session).
  transferPlanningFinal Boolean     @default(false) @map("transfer_planning_final")
  /// Session-specific feedback, configured separately and linked to this session (brief 6.2).
  feedbackEnabled       Boolean     @default(false) @map("feedback_enabled")
  /// Short code in the session's feedback link and QR code; set when feedback is enabled.
  feedbackCode          String?     @unique @map("feedback_code")
  /// When the organisers started the encouraged five-minute period; informational, not a gate.
  feedbackOpenedAt      DateTime?   @map("feedback_opened_at") @db.Timestamptz(3)
  /// The configured deadline; the form stays open until then (never closed after five minutes).
  feedbackClosesAt      DateTime?   @map("feedback_closes_at") @db.Timestamptz(3)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  event             Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventDate         EventDate                 @relation(fields: [eventDateId], references: [id], onDelete: Restrict)
  attendance        SessionAttendance[]
  feedbackQuestions SessionFeedbackQuestion[]
  feedbackResponses SessionFeedbackResponse[]

  @@index([eventId])
  @@index([eventDateId])
  @@map("event_session")
}

/// One of the three assessment stages of an event (E1 brief, section 6), enabled and scheduled
/// independently. Questions are versioned data of later increments and hang off this row.
/// Versioned like assessment questions: an edit after answers retires the row and creates
/// version + 1 under the same key.
model SessionFeedbackQuestion {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String               @map("session_id") @db.Uuid
  eventId     String               @map("event_id") @db.Uuid
  questionKey String               @default(dbgenerated("gen_random_uuid()")) @map("question_key") @db.Uuid
  version     Int                  @default(1)
  order       Int
  prompt      String
  type        FeedbackQuestionType @default(rating)
  required    Boolean              @default(true)
  retiredAt   DateTime?            @map("retired_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  session EventSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event   Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers SessionFeedbackAnswer[]

  @@unique([questionKey, version])
  @@index([sessionId])
  @@map("session_feedback_question")
}

/// One logical response per delegate per session; an update replaces the answers, bumps the
/// revision and keeps the previous answers in session_feedback_revision.
model SessionFeedbackResponse {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  delegateId  String   @map("delegate_id") @db.Uuid
  revision    Int      @default(1)
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(3)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(3)

  session   EventSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event     Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  delegate  Delegate                  @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  answers   SessionFeedbackAnswer[]
  revisions SessionFeedbackRevision[]

  @@unique([sessionId, delegateId])
  @@index([delegateId])
  @@map("session_feedback_response")
}

model SessionFeedbackAnswer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId String   @map("response_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  value      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  response SessionFeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SessionFeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("session_feedback_answer")
}

/// Earlier revisions of a response, as submitted (question id to value), for the audit history.
model SessionFeedbackRevision {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId  String   @map("response_id") @db.Uuid
  revision    Int
  answers     Json
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  response SessionFeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, revision])
  @@map("session_feedback_revision")
}

model TransferPlan {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String             @map("event_id") @db.Uuid
  delegateId        String             @map("delegate_id") @db.Uuid
  status            TransferPlanStatus @default(draft)
  /// Bumped on every save; a save with an older version is refused (no silent overwrite).
  version           Int                @default(1)
  submittedAt       DateTime?          @map("submitted_at") @db.Timestamptz(3)
  /// The plan exactly as submitted (TransferPlanView), never changed afterwards.
  submittedSnapshot Json?              @map("submitted_snapshot")
  reminderFrequency ReminderFrequency  @default(none) @map("reminder_frequency")
  reminderStartOn   DateTime?          @map("reminder_start_on") @db.Date
  nextReminderAt    DateTime?          @map("next_reminder_at") @db.Timestamptz(3)
  updatedByUserId   String?            @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  event     Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  delegate  Delegate                  @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  actions   TransferPlanAction[]
  reminders TransferPlanReminderLog[]

  @@unique([eventId, delegateId])
  @@index([nextReminderAt])
  @@map("transfer_plan")
}

model TransferPlanAction {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId           String               @map("plan_id") @db.Uuid
  order            Int
  isPriority       Boolean              @default(false) @map("is_priority")
  priorityLearning String               @default("") @map("priority_learning")
  action           String               @default("")
  opportunity      String               @default("")
  firstStep        String               @default("") @map("first_step")
  startOn          DateTime?            @map("start_on") @db.Date
  targetOn         DateTime?            @map("target_on") @db.Date
  stakeholders     String               @default("")
  support          String               @default("")
  barriers         String               @default("")
  evidence         String               @default("")
  expectedResult   String               @default("") @map("expected_result")
  measure          String               @default("")
  baseline         String               @default("")
  reviewOn         DateTime?            @map("review_on") @db.Date
  progressStatus   ActionProgressStatus @default(not_started) @map("progress_status")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan     TransferPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  progress TransferPlanProgress[]

  @@index([planId])
  @@map("transfer_plan_action")
}

model TransferPlanProgress {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actionId         String               @map("action_id") @db.Uuid
  status           ActionProgressStatus
  note             String?
  evidence         String?
  results          String?
  challenges       String?
  newTargetOn      DateTime?            @map("new_target_on") @db.Date
  recordedAt       DateTime             @default(now()) @map("recorded_at") @db.Timestamptz(3)
  recordedByUserId String               @map("recorded_by_user_id") @db.Uuid

  action TransferPlanAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("transfer_plan_progress")
}

/// One row per reminder attempt, so scheduling and delivery stay traceable.
model TransferPlanReminderLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId       String    @map("plan_id") @db.Uuid
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(3)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(3)
  status       String
  error        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  plan TransferPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("transfer_plan_reminder_log")
}

/// The pre-event questions an event shows back beside the Transfer Plan and in the final
/// evaluation (the first is the expectation the evaluation asks about), in the admin's order.
/// Set per event; nothing is hard-coded.
model EventReferenceQuestion {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String @map("event_id") @db.Uuid
  order       Int
  questionKey String @map("question_key") @db.Uuid

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, questionKey])
  @@map("event_reference_question")
}

model AssessmentStageConfig {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String                @map("event_id") @db.Uuid
  stage       AssessmentStage
  enabled     Boolean               @default(false)
  opensAt     DateTime?             @map("opens_at") @db.Timestamptz(3)
  closesAt    DateTime?             @map("closes_at") @db.Timestamptz(3)
  target      AssessmentTarget      @default(all_delegates)
  targetGroup String?               @map("target_group")
  status      AssessmentStageStatus @default(draft)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]
  responses AssessmentResponse[]
  sections  AssessmentSection[]

  @@unique([eventId, stage])
  @@map("assessment_stage_config")
}

/// A titled group of questions within one stage; delegates see one section per step.
model AssessmentSection {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageConfigId   String          @map("stage_config_id") @db.Uuid
  eventId         String          @map("event_id") @db.Uuid
  title           String
  description     String?
  order           Int
  marking         SectionMarking  @default(none)
  audience        SectionAudience @default(all)
  /// Set when the section repeats another stage's section (same wording, options and marking)
  /// so the two stages' answers can be paired per delegate (backlog E11-4 to E11-7).
  sourceSectionId String?         @map("source_section_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  stage     AssessmentStageConfig @relation(fields: [stageConfigId], references: [id], onDelete: Cascade)
  event     Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  source    AssessmentSection?    @relation("SectionMirror", fields: [sourceSectionId], references: [id], onDelete: SetNull)
  mirrors   AssessmentSection[]   @relation("SectionMirror")
  questions AssessmentQuestion[]

  @@index([stageConfigId])
  @@index([sourceSectionId])
  @@map("assessment_section")
}

/// A question of one assessment stage. Versioned: an edit after answers exist creates a new row with
/// the same question_key and version + 1 and retires this one; answers keep pointing at the version
/// they answered (CLAUDE.md: questions are data, versioned; responses store the question version).
model AssessmentQuestion {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageConfigId     String       @map("stage_config_id") @db.Uuid
  eventId           String       @map("event_id") @db.Uuid
  questionKey       String       @default(dbgenerated("gen_random_uuid()")) @map("question_key") @db.Uuid
  /// Optional section the question is shown under; null means the first, untitled group.
  sectionId         String?      @map("section_id") @db.Uuid
  version           Int          @default(1)
  order             Int
  prompt            String
  helpText          String?      @map("help_text")
  type              QuestionType
  required          Boolean      @default(true)
  area              String?
  options           Json?
  scale             Json?
  /// The question_key this question repeats from another stage (mirrored sections); answers to
  /// the two are paired per delegate in reports. Wording and options stay locked.
  sourceQuestionKey String?      @map("source_question_key") @db.Uuid
  /// A built-in block question (expectations, readiness); see builtinBlocks in @mbc/shared.
  builtin           String?
  retiredAt         DateTime?    @map("retired_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  stage   AssessmentStageConfig @relation(fields: [stageConfigId], references: [id], onDelete: Cascade)
  event   Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  section AssessmentSection?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  answers AssessmentAnswer[]

  @@unique([questionKey, version])
  @@index([stageConfigId])
  @@index([sectionId])
  @@map("assessment_question")
}

/// One delegate's response to one stage: a draft until submitted_at is set.
model AssessmentResponse {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stageConfigId String    @map("stage_config_id") @db.Uuid
  delegateId    String    @map("delegate_id") @db.Uuid
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  stage    AssessmentStageConfig         @relation(fields: [stageConfigId], references: [id], onDelete: Cascade)
  delegate Delegate                      @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  answers  AssessmentAnswer[]
  sections AssessmentSectionSubmission[]

  @@unique([stageConfigId, delegateId])
  @@index([delegateId])
  @@map("assessment_response")
}

/// A section the delegate submitted on its own (decided 2026-10-30: sections are submitted
/// separately; the response is submitted once every section with questions is). The key is
/// the section id, or "general" for the questions outside any section.
model AssessmentSectionSubmission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId  String   @map("response_id") @db.Uuid
  sectionKey  String   @map("section_key")
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(3)

  response AssessmentResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, sectionKey])
  @@map("assessment_section_submission")
}

/// One answer, pointing at the exact question version it answered.
model AssessmentAnswer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId String   @map("response_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  value      Json
  /// Knowledge questions: whether the answer was the correct option (null for other questions).
  correct    Boolean?
  /// Points of the chosen option (1/0 for knowledge, option score otherwise, null when not scored).
  score      Int?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  response AssessmentResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([responseId, questionId])
  @@index([questionId])
  @@map("assessment_answer")
}

model ParticipationCategory {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String            @map("event_id") @db.Uuid
  code      ParticipationCode
  name      String
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@index([eventId])
  @@map("participation_category")
}

// ------------------------------------------------------------------ accounts and delegates (E2, E3)

model UserAccount {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Stored lower-cased and trimmed; a unique index on lower(email) in the migration enforces it.
  email        String     @unique
  role         UserRole
  status       UserStatus @default(active)
  lastSignInAt DateTime?  @map("last_sign_in_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  delegates    Delegate[]
  authSessions AuthSession[]
  signInTokens SignInToken[]
  identity     DelegateIdentity?

  @@map("user_account")
}

// ------------------------------------------------------------------ platform identity (backlog D6, D5.1)

/// One row per person across events (E2-2). The current, historical and provisional addresses
/// live in identity_email, where one unique index enforces global ownership (H1, H4).
model DelegateIdentity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Established name, preserved across imports (D5: never overwritten by a file).
  displayName   String   @map("display_name")
  /// The authentication account linked at first sign-in or by the backfill; at most one per identity.
  userAccountId String?  @unique @map("user_account_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userAccount UserAccount?    @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  emails      IdentityEmail[]
  delegates   Delegate[]

  @@map("delegate_identity")
}

/// Address ownership store. `emailNormalised` is unique across every kind, so an address can be
/// the current, historical or provisional address of at most one identity (D5.1 invariants 1, 3).
/// A partial unique index in the migration also guarantees one current address per identity.
model IdentityEmail {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId      String                @map("identity_id") @db.Uuid
  /// normaliseEmail(): NFC, trimmed, lower-cased.
  emailNormalised String                @unique @map("email_normalised")
  kind            IdentityEmailKind
  evidence        IdentityEmailEvidence
  /// The audit_log row that established this address, when one exists (no FK: audit rows outlive records).
  auditLogId      String?               @map("audit_log_id") @db.Uuid
  actorUserId     String?               @map("actor_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  identity DelegateIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@index([identityId])
  @@map("identity_email")
}

model Delegate {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                String             @map("event_id") @db.Uuid
  userAccountId          String?            @map("user_account_id") @db.Uuid
  /// Platform identity (D6); nullable during the expand phase, filled by the backfill (D6.1).
  identityId             String?            @map("identity_id") @db.Uuid
  name                   String
  email                  String
  organisation           String?
  jobTitle               String?            @map("job_title")
  country                String?
  attendanceFormat       ParticipationCode  @map("attendance_format")
  capacity               DelegateCapacity   @default(individual)
  nominatingOrganisation String?            @map("nominating_organisation")
  registrationStatus     RegistrationStatus @default(active) @map("registration_status")
  duplicateOfId          String?            @map("duplicate_of_id") @db.Uuid
  /// Registration source the record was imported from (D4); scopes the external id.
  registrationSource     String?            @map("registration_source")
  /// The registration platform's own id for the row, unique per event and source (D4, D5).
  externalRegistrationId String?            @map("external_registration_id")
  importedAt             DateTime?          @map("imported_at") @db.Timestamptz(3)
  /// Set when the delegate first signs in and the account is linked (E3-2).
  signedUpAt             DateTime?          @map("signed_up_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  event               Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userAccount         UserAccount?               @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  identity            DelegateIdentity?          @relation(fields: [identityId], references: [id], onDelete: Restrict)
  duplicateOf         Delegate?                  @relation("DelegateDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates          Delegate[]                 @relation("DelegateDuplicates")
  invitations         Invitation[]
  consents            ConsentRecord[]
  importRows          ImportRow[]
  messages            DelegateMessageRecipient[]
  assessmentResponses AssessmentResponse[]
  attendanceTokens    AttendanceToken[]
  attendanceRecords   AttendanceRecord[]
  sessionAttendance   SessionAttendance[]
  reflectionResponses ReflectionResponse[]
  sessionFeedback     SessionFeedbackResponse[]
  transferPlans       TransferPlan[]

  @@index([eventId])
  @@index([email])
  @@index([userAccountId])
  @@index([identityId])
  @@index([eventId, registrationStatus])
  @@map("delegate")
}

// ------------------------------------------------------------------ registration imports (E2-1, E2-8..11; D3, D6, D9)

/// One per upload. Row contents live in import_row; the run holds who, when, file name and hash,
/// mapping, counts and outcome (D3 step 7). The original file is not retained (OQ-22 open).
model ImportRun {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                 String             @map("event_id") @db.Uuid
  actorUserId             String             @map("actor_user_id") @db.Uuid
  /// Registration source chosen explicitly by the admin (D3 step 1, D4).
  source                  String
  fileName                String             @map("file_name")
  /// SHA-256 of the uploaded bytes; part of the preview fingerprint.
  fileHash                String             @map("file_hash")
  fileSizeBytes           Int                @map("file_size_bytes")
  rowCount                Int                @map("row_count")
  /// Header names as read from the file, in column order.
  headers                 Json
  mapping                 Json?
  attendanceFormatDefault ParticipationCode? @map("attendance_format_default")
  /// Admin translations of file values for the enumerated fields (D4); part of the fingerprint.
  valueMappings           Json?              @map("value_mappings")
  status                  ImportRunStatus    @default(uploaded)
  /// Hash of file, mapping and the snapshot of matched records (D3 step 5); null until previewed.
  fingerprint             String?
  previewExpiresAt        DateTime?          @map("preview_expires_at") @db.Timestamptz(3)
  counts                  Json?
  committedAt             DateTime?          @map("committed_at") @db.Timestamptz(3)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rows  ImportRow[]

  @@index([eventId, createdAt])
  @@map("import_run")
}

/// One per file row: the raw cells, the normalised values once mapped, the outcome and reason,
/// both sides of a conflict, and the delegate or identity it produced or touched (D6).
model ImportRow {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId             String            @map("run_id") @db.Uuid
  /// 1-based data row number as the admin sees it in the file (the header is row 1).
  rowNumber         Int               @map("row_number")
  raw               Json
  values            Json?
  outcome           ImportRowOutcome?
  reasonCode        String?           @map("reason_code")
  reasonDetail      String?           @map("reason_detail")
  possibleDuplicate Boolean           @default(false) @map("possible_duplicate")
  conflict          Json?
  delegateId        String?           @map("delegate_id") @db.Uuid
  identityId        String?           @map("identity_id") @db.Uuid
  /// Admin decision on a conflict row (D5); null while the row waits in the queue.
  resolution        ImportResolution? @map("resolution")
  resolvedAt        DateTime?         @map("resolved_at") @db.Timestamptz(3)
  resolvedByUserId  String?           @map("resolved_by_user_id") @db.Uuid
  resolutionNote    String?           @map("resolution_note")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  run      ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  delegate Delegate? @relation(fields: [delegateId], references: [id], onDelete: SetNull)

  @@unique([runId, rowNumber])
  @@index([runId, outcome])
  @@map("import_row")
}

/// Column mapping saved per registration source (E2-8, D4); reused only when the header
/// signature matches exactly, otherwise the admin confirms a mapping again.
model ImportSourceMapping {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source          String   @unique
  headerSignature String   @map("header_signature")
  mapping         Json
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("import_source_mapping")
}

/// An email an admin wrote and sent to selected registrations of one event (E2-14).
model DelegateMessage {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String                @map("event_id") @db.Uuid
  /// The admin who sent it; kept as an id (no relation) like import_run.actor_user_id.
  createdByUserId    String                @map("created_by_user_id") @db.Uuid
  subject            String
  /// Body as written, in the message markdown subset; rendered per recipient at send time.
  body               String
  /// How the recipients were chosen (ids or a listing filter); never the addresses.
  recipientSelection Json                  @map("recipient_selection")
  status             DelegateMessageStatus @default(sending)
  recipientCount     Int                   @map("recipient_count")
  sentCount          Int                   @default(0) @map("sent_count")
  failedCount        Int                   @default(0) @map("failed_count")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz(3)

  event      Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipients DelegateMessageRecipient[]

  @@index([eventId, createdAt])
  @@map("delegate_message")
}

model DelegateMessageRecipient {
  id                String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId         String                         @map("message_id") @db.Uuid
  delegateId        String                         @map("delegate_id") @db.Uuid
  status            DelegateMessageRecipientStatus @default(queued)
  sentAt            DateTime?                      @map("sent_at") @db.Timestamptz(3)
  /// What the transport returned; no address.
  providerMessageId String?                        @map("provider_message_id")
  /// Short failure class ("delivery_failed"); never the error text, which may carry the address.
  failureReason     String?                        @map("failure_reason")

  message  DelegateMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  delegate Delegate        @relation(fields: [delegateId], references: [id], onDelete: Cascade)

  @@unique([messageId, delegateId])
  @@index([delegateId])
  @@map("delegate_message_recipient")
}

model Invitation {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delegateId String           @map("delegate_id") @db.Uuid
  /// SHA-256 of the single-use token; the token itself is never stored.
  tokenHash  String           @unique @map("token_hash")
  status     InvitationStatus @default(pending)
  sentAt     DateTime?        @map("sent_at") @db.Timestamptz(3)
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(3)
  bouncedAt  DateTime?        @map("bounced_at") @db.Timestamptz(3)
  expiresAt  DateTime?        @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  delegate Delegate @relation(fields: [delegateId], references: [id], onDelete: Cascade)

  @@index([delegateId])
  @@map("invitation")
}

model ConsentRecord {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delegateId String          @map("delegate_id") @db.Uuid
  document   ConsentDocument @default(privacy)
  version    String
  acceptedAt DateTime        @default(now()) @map("accepted_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  delegate Delegate @relation(fields: [delegateId], references: [id], onDelete: Cascade)

  @@unique([delegateId, document, version])
  @@index([delegateId])
  @@map("consent_record")
}

// ------------------------------------------------------------------ audit log (E17-4), append-only
// No foreign keys on purpose: audit rows must outlive the records and users they describe, and an
// ON DELETE SET NULL would be an UPDATE, which the append-only trigger rejects. event_id and
// actor_user_id are historical references.

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  eventId     String?  @map("event_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Verb in dotted form, e.g. "delegate.status_changed", "export.created".
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ip          String?
  userAgent   String?  @map("user_agent")

  @@index([eventId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([occurredAt])
  @@map("audit_log")
}

// ------------------------------------------------------------------ authentication (E3-3..6)

/// Server-side session. The cookie carries a random token; only its SHA-256 is stored here.
model AuthSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccountId String    @map("user_account_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Absolute expiry (SESSION_TTL_DAYS); idle expiry is derived from lastSeenAt.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// SHA-256 of the client IP; never the IP itself.
  ipHash        String?   @map("ip_hash")
  userAgent     String?   @map("user_agent")

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@index([userAccountId])
  @@index([expiresAt])
  @@map("auth_session")
}

/// Magic link / one-time code. Raw token and code are emailed once; only hashes are stored.
model SignInToken {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lower-cased address the link was sent to.
  email         String
  userAccountId String?       @map("user_account_id") @db.Uuid
  purpose       SignInPurpose @default(signin)
  tokenHash     String        @unique @map("token_hash")
  codeHash      String?       @map("code_hash")
  expiresAt     DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime?     @map("used_at") @db.Timestamptz(3)
  /// Failed verification attempts against this token (code guessing).
  attempts      Int           @default(0)
  /// Relative path to return to after sign-in (deep links, E3-5).
  targetPath    String?       @map("target_path")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  userAccount UserAccount? @relation(fields: [userAccountId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("sign_in_token")
}

/// Rate-limiting ledger for authentication requests; survives restarts and multiple api replicas.
model AuthAttempt {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        AuthAttemptKind
  /// Keyed hash of the normalised email (no plaintext addresses in the ledger).
  emailHash   String?         @map("email_hash")
  ipHash      String?         @map("ip_hash")
  attemptedAt DateTime        @default(now()) @map("attempted_at") @db.Timestamptz(3)

  @@index([emailHash, attemptedAt])
  @@index([ipHash, attemptedAt])
  @@map("auth_attempt")
}

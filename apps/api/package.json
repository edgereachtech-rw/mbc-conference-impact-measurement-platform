{
  "name": "@mbc/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express REST API (/api/v1) and pg-boss worker (second entry point, same package)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma": "prisma"
  },
  "dependencies": {
    "@mbc/shared": "workspace:*",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "dotenv": "18.0.9",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

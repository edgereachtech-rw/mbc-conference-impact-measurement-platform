# Copy to deploy/.env and fill in real values. Never commit .env.
# Generate secrets with:  openssl rand -base64 32   (or: openssl rand -hex 32)

# ------------------------------------------------------------------ which stack compose runs
# With this set, a bare `docker compose up -d --build` in deploy/ runs the production stack and
# the development override is never merged. Every other compose command follows suit, so `logs`,
# `ps` and `down` all talk to the same definition.
#
# For the development stack (hot reload, bind-mounted repo, loopback ports) name both files:
#   docker compose -f docker-compose.yml -f docker-compose.override.yml up -d
# or comment this line out, which restores Compose's automatic merge.
COMPOSE_FILE=docker-compose.yml

# ------------------------------------------------------------------ the two public origins
# There is no reverse proxy in this stack (removed 2026-10-31): the web container and the api
# container each publish a port, and the browser calls the API on its own origin.
#
# TLS is not part of the stack. Terminate it in front of the server (cloud load balancer,
# Cloudflare, or a host-level proxy) and point these two names at it. The API refuses to start in
# production unless APP_URL is https.
#
# The two origins must be SAME-SITE, or the server-rendered pages cannot read the session cookie:
#   - one hostname, two ports:  impact.example.com:33333 and impact.example.com:44444
#     -> leave COOKIE_DOMAIN empty (cookies ignore the port)
#   - two subdomains:           app.example.com and api.example.com
#     -> set COOKIE_DOMAIN=example.com
# Two unrelated domains will not work.

# Hostname (and port, if not the default) where delegates reach the web app.
APP_DOMAIN=impact.example.com
# Hostname (and port) where the browser reaches the API. Compose passes it to the web container,
# which publishes it to the page; the browser calls it directly.
API_PUBLIC_URL=https://impact.example.com:44444
# Ports published on the host. Change these if something else already uses them.
WEB_PUBLISH=33333
API_PUBLISH=44444
# Parent domain for the session cookie. Required only when APP_DOMAIN and the API host differ.
COOKIE_DOMAIN=

# ------------------------------------------------------------------ runtime
NODE_ENV=production
# Absolute origin used in emails and links, and the origin the API accepts browser calls from.
# Compose derives it as https://APP_DOMAIN when this is empty. Set it when the scheme or the port
# differ, which they do for a local run of the production images: APP_URL=http://localhost:33333.
# NODE_ENV=production refuses a non-https value, so a plain-HTTP run needs another NODE_ENV.
#APP_URL=https://impact.example.com
# Logger "service" field; compose leaves it to the default (api) and the worker labels itself.
#SERVICE_NAME=api
# Port the API listens on inside its container; API_PUBLISH maps it onto the host.
PORT=44444
# pino log level for api and worker: fatal, error, warn, info, debug.
LOG_LEVEL=info
# Event timezone for display and scheduling; storage is always UTC.
EVENT_TIMEZONE=Africa/Lagos
# Image tag to run. CI sets this to the git commit; rollback = redeploy the previous tag.
IMAGE_PREFIX=mbc-impact
IMAGE_TAG=local

# ------------------------------------------------------------------ PostgreSQL 16 (service "db")
DB_NAME=mbc_impact
DB_USER=mbc
DB_PASSWORD=change-me-db-password
# Must match the three values above; "db" is the compose service name.
DATABASE_URL=postgresql://mbc:change-me-db-password@db:5432/mbc_impact

# ------------------------------------------------------------------ object storage (S3 API)
# Garage inside the stack. For an external bucket set the provider's endpoint, region and keys and
# remove the garage service.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
# Any 26+ character id and a long secret; deploy/scripts/garage-init.sh imports them into Garage.
S3_ACCESS_KEY=GKchange-me-access-key-id
S3_SECRET_KEY=change-me-s3-secret-key
S3_BUCKET=mbc-impact
# Garage internals (32-byte hex secrets: openssl rand -hex 32). Not used by the app.
GARAGE_RPC_SECRET=change-me-64-hex-chars
GARAGE_ADMIN_TOKEN=change-me-admin-token
# Disk capacity to allot to Garage on first init (see garage-init.sh).
GARAGE_CAPACITY=20G

# ------------------------------------------------------------------ email (SMTP relay via Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=change-me-smtp-password
# Sending identity. The domain must have SPF, DKIM and DMARC set up (backlog E0-12).
# Sending address should be on the authenticated sending (sub)domain, see docs/email-setup.md
MAIL_FROM="ITTEC 2026 <conference@mbryanconsultinggroup.com>"
# Reply-To and footer address delegates can write to.
MAIL_CONTACT_EMAIL=conference@mbryanconsultinggroup.com
# Organiser shown in the email footer ("Sent by ...").
MAIL_ORGANISER_NAME=M.Bryan Consulting
# Transport: smtp on servers; the dev override uses mailpit.
MAIL_TRANSPORT=smtp
# Development inbox (only used when MAIL_TRANSPORT=mailpit, e.g. by the Compose override).
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
# Fallback event name in emails when no event row exists yet (seed creates the real one).
MAIL_EVENT_NAME=

# ------------------------------------------------------------------ seed data (node dist/seed.js in the api image)
# First admin account. Sign-in is by magic link, so no password exists anywhere.
ADMIN_EMAIL=admin@example.com
# true on staging only: creates 10 delegates flagged registration_status = test (E0-5).
# The seed refuses to create them when NODE_ENV=production.
SEED_TEST_DELEGATES=false

# ------------------------------------------------------------------ security and monitoring
# Keys the hashes of client addresses and email identities kept in the sign-in attempt ledger and
# the audit log, so neither holds plaintext identities. 32+ random characters; the API refuses to
# start in production with a shorter or placeholder value. Rotating it resets rate-limit counters.
SESSION_SECRET=change-me-session-secret
# Session policy (E3-5): absolute and idle lifetimes in days, magic-link validity in minutes.
SESSION_TTL_DAYS=14
SESSION_IDLE_DAYS=7
MAGIC_LINK_TTL_MINUTES=15
# Sign-in link requests allowed per email per 15 minutes. This is the primary abuse control: it caps
# the mail any one address can receive, and responses never reveal whether an address is registered.
AUTH_RATE_LIMIT_PER_EMAIL=3
# Per-address limits: link requests and failed verifications per client address per hour. Physical
# delegates share the venue's NAT address, so the code defaults (10 and 20) would lock a room out.
# CONFIRM BEFORE GO-LIVE: no attendance figure is documented yet. Set AUTH_RATE_LIMIT_PER_IP to at
# least twice the number of physical delegates expected to sign in from the venue network within one
# hour, and AUTH_VERIFY_LIMIT_PER_IP to roughly the same. The values below are conservative
# placeholders, not validated figures. Abuse from a shared address stays bounded by the per-email
# limit (3 per 15 minutes) and by the 5 code attempts allowed per link.
AUTH_RATE_LIMIT_PER_IP=60
AUTH_VERIFY_LIMIT_PER_IP=60
# Extra browser origins allowed to make state-changing API requests and to pass CORS. APP_URL (the
# web app) is always allowed, so leave this empty unless a second origin serves the app (https only).
AUTH_ALLOWED_ORIGINS=
# Express trust-proxy value naming the network a TLS terminator or load balancer reaches the
# container from, so X-Forwarded-* is honoured only from there. "uniquelocal" covers the private
# ranges, which is right when the terminator runs on the same host or in Docker. "false" trusts
# nobody. Required in production so forwarded-address handling is an explicit decision.
TRUST_PROXY=uniquelocal
# Sentry project DSN for web and api. Empty disables error tracking.
SENTRY_DSN=
# Environment tag on Sentry events (staging or production); release is IMAGE_TAG automatically.
SENTRY_ENVIRONMENT=production
# Browser-side Sentry needs the DSN at build time (NEXT_PUBLIC_*); leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
# Optional build-time labels for browser events (default: none).
#NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
#NEXT_PUBLIC_SENTRY_RELEASE=
# Release tag on events. Compose sets it to IMAGE_TAG (the git SHA); override only for local builds.
#SENTRY_RELEASE=
# Healthchecks.io ping URLs (E0-7, E0-9). Empty disables the pings.
HEALTHCHECKS_WORKER_URL=
# Seconds between worker heartbeat pings (Healthchecks.io period should be the same, grace 5 min).
HEARTBEAT_INTERVAL_SECONDS=120
HEALTHCHECKS_BACKUP_URL=

# ------------------------------------------------------------------ backups (service "backup", E0-7)
# nightly = 02:00 Africa/Lagos every day (RPO 24 h). hourly = every hour (RPO 1 h): switch to
# hourly for 12-13 November 2026 and back afterwards. Details: docs/backup-and-recovery.md
BACKUP_MODE=nightly
# age public key (age1...) that encrypts every dump before it leaves the server. Generate the pair
# OFF the server with `age-keygen`; the private key lives in the password manager, never here.
BACKUP_AGE_PUBLIC_KEY=age1changeme
# Off-site S3-compatible bucket at a different provider/account from the primary object storage.
# BACKUP_S3_PROVIDER: Other (Backblaze B2 S3 API, Garage, Hetzner), Cloudflare (R2), AWS.
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=mbc-impact-backups
BACKUP_S3_ACCESS_KEY=change-me
BACKUP_S3_SECRET_KEY=change-me
# Passphrase of the rclone crypt remote that encrypts the object copy (objects/). Keep it with the
# age private key, off the server. Empty = objects are copied unencrypted (not for production).
BACKUP_RCLONE_CRYPT_PASSWORD=change-me-crypt-passphrase
# Retention: number of dumps kept per tier.
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

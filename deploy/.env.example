# Copy to deploy/.env and fill in real values. Never commit .env.
# Generate secrets with:  openssl rand -base64 32   (or: openssl rand -hex 32)

# ------------------------------------------------------------------ domain and TLS
# Public hostname served by Caddy. Local development uses "http://localhost" (see the override file).
APP_DOMAIN=impact.example.com
# Contact address for the Let's Encrypt account (expiry warnings go here).
ACME_EMAIL=ops@example.com
# Optional Content-Security-Policy additions (leading space!). Leave empty in production unless needed.
CSP_SCRIPT_EXTRA=
CSP_CONNECT_EXTRA=

# ------------------------------------------------------------------ runtime
NODE_ENV=production
# Event timezone for display and scheduling; storage is always UTC.
EVENT_TIMEZONE=Africa/Lagos
# Image tag to run. CI sets this to the git commit; rollback = redeploy the previous tag.
IMAGE_PREFIX=mbc-impact
IMAGE_TAG=local

# ------------------------------------------------------------------ PostgreSQL 16 (service "db")
DB_NAME=mbc_impact
DB_USER=mbc
DB_PASSWORD=change-me-db-password
# Must match the three values above; "db" is the compose service name.
DATABASE_URL=postgresql://mbc:change-me-db-password@db:5432/mbc_impact

# ------------------------------------------------------------------ object storage (S3 API)
# Garage inside the stack. For an external bucket set the provider's endpoint, region and keys and
# remove the garage service.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
# Any 26+ character id and a long secret; deploy/scripts/garage-init.sh imports them into Garage.
S3_ACCESS_KEY=GKchange-me-access-key-id
S3_SECRET_KEY=change-me-s3-secret-key
S3_BUCKET=mbc-impact
# Garage internals (32-byte hex secrets: openssl rand -hex 32). Not used by the app.
GARAGE_RPC_SECRET=change-me-64-hex-chars
GARAGE_ADMIN_TOKEN=change-me-admin-token
# Disk capacity to allot to Garage on first init (see garage-init.sh).
GARAGE_CAPACITY=20G

# ------------------------------------------------------------------ email (SMTP relay via Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=change-me-smtp-password
# Sending identity. The domain must have SPF, DKIM and DMARC set up (backlog E0-12).
MAIL_FROM="ITTEC 2026 <conference@mbryanconsultinggroup.com>"

# ------------------------------------------------------------------ security and monitoring
# Signs sessions and magic links. 32+ random bytes. Rotating it signs everyone out.
SESSION_SECRET=change-me-session-secret
# Sentry project DSN for web and api. Empty disables error tracking.
SENTRY_DSN=
# Healthchecks.io ping URLs (E0-7, E0-9). Empty disables the pings.
HEALTHCHECKS_WORKER_URL=
HEALTHCHECKS_BACKUP_URL=

# ------------------------------------------------------------------ backups (service "backup", E0-7)
# Cron expression (UTC). Hourly on conference days is handled by the job itself.
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
# Symmetric key used to encrypt pg_dump output before it leaves the server.
BACKUP_ENCRYPTION_KEY=change-me-backup-key
# Off-site destination (a different provider or account from the primary storage).
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_BUCKET=mbc-impact-backups
BACKUP_S3_ACCESS_KEY=change-me
BACKUP_S3_SECRET_KEY=change-me

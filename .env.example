# Copy to .env (never commit .env). Values below are local-development defaults.

# PostgreSQL 16 connection string used by the API, the worker and Prisma.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mbc_impact

# API HTTP port
PORT=4000

# Event timezone (times are stored in UTC; this is for display and scheduling)
EVENT_TIMEZONE=Africa/Lagos

# Seed script (pnpm --filter @mbc/api db:seed). The admin account is created with this email.
ADMIN_EMAIL=admin@example.com
# Create 10 delegates with registration_status "test". Never honoured when NODE_ENV=production.
SEED_TEST_DELEGATES=true

# Email. MAIL_TRANSPORT: smtp (relay), mailpit (dev inbox at http://127.0.0.1:8025), memory (tests).
MAIL_TRANSPORT=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Conference Impact Platform <no-reply@example.com>"
MAIL_CONTACT_EMAIL=conference@example.com
MAIL_ORGANISER_NAME=
# Absolute origin used in email links and for the logo image.
APP_URL=http://localhost:3000

# Authentication (apps/api). Durations are configurable; defaults suit the conference week (E3-5).
SESSION_TTL_DAYS=14
SESSION_IDLE_DAYS=7
MAGIC_LINK_TTL_MINUTES=15
AUTH_RATE_LIMIT_PER_EMAIL=3
AUTH_RATE_LIMIT_PER_IP=10
AUTH_VERIFY_LIMIT_PER_IP=20
# Extra origins allowed to make state-changing API requests (the Next dev server).
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Set to false only when developing over plain http (requires NODE_ENV=development or test).
COOKIE_SECURE=false
NODE_ENV=development
# Reverse proxies whose forwarded headers are trusted. Nobody on the host (requests come straight
# from the browser or the Next dev server on loopback); Docker sets uniquelocal for Caddy.
TRUST_PROXY=false
# Keys the hashed identities in the sign-in ledger. Optional here (a development key is used);
# production refuses to start without 32+ random characters.
SESSION_SECRET=

# Web app (apps/web): where server components reach the API, and the dev-server proxy target.
API_INTERNAL_URL=http://127.0.0.1:4000
API_PROXY_URL=http://127.0.0.1:4000
